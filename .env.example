# Copy this file to both .env.local and .env.runtime.local for development.
# Set each value only in the file named by its ownership section. Never commit
# real values. SECRETS.md is the canonical environment-ownership inventory.

# =============================================================================
# Cross-boundary credential pair: configure matching keys in Convex and runtime
# =============================================================================
# Convex receives only the public key; the runtime owns the private key.
MONTECARLO_BLOB_ATTESTATION_PUBLIC_KEY=
MONTECARLO_BLOB_ATTESTATION_PRIVATE_KEY=

# =============================================================================
# Convex-only secrets
# =============================================================================
BETTER_AUTH_SECRET=dev-change-me-please-use-a-long-random-secret
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Optional for local development and preview; production deployment requires it.
POSTHOG_PROJECT_TOKEN=

# =============================================================================
# Runtime-only secrets
# =============================================================================
# Optional user-managed provider credential. Electron's credential flow is preferred.
OPENROUTER_API_KEY=
# Optional administrator-provisioned provider credential for a trusted runtime.
MONTECARLO_MANAGED_OPENROUTER_API_KEY=
# Required outside development; production Electron receives a per-launch value over IPC.
MONTECARLO_RUNTIME_TOKEN=
# Required only when R2 storage is configured.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =============================================================================
# Deployment-only secrets
# =============================================================================
# Normally supplied by Vercel or the Convex CLI rather than a local dotenv file.
# CONVEX_DEPLOY_KEY=
# CONVEX_SELF_HOSTED_ADMIN_KEY=

# =============================================================================
# Convex non-secret configuration
# =============================================================================
SITE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
# Address only; outbound email adds the app display name.
RESEND_FROM_EMAIL=onboarding@resend.dev
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_DISABLED=
# Local-only destructive dev tools. The backend also requires SITE_URL to be localhost.
ENABLE_DANGEROUS_DEV_TOOLS=true
# Allows an account-free identity only when SITE_URL is loopback. Never enable in cloud.
ALLOW_LOCAL_ANONYMOUS_WORKSPACES=true

# =============================================================================
# Runtime non-secret configuration
# =============================================================================
# Optional storage scope for a locked-down companion instance.
MONTECARLO_RUNTIME_WORKSPACE_IDS=
# Optional paths when the official CLIs are not on PATH.
CODEX_PATH=
CLAUDE_PATH=
# Supplying all R2 values enables R2 alongside the always-available filesystem store.
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=
# Optional filesystem storage override; defaults to the OS application-data directory.
MONTECARLO_WORKSPACES_DIR=
# Optional compatible-endpoint overrides; defaults live in apps/runtime/src/config.ts.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# =============================================================================
# Convex CLI and deployment configuration
# =============================================================================
# CONVEX_DEPLOYMENT=
# CONVEX_SELF_HOSTED_URL=

# =============================================================================
# Browser build and local web configuration (public, including TOKEN-named values)
# =============================================================================
# VITE_CONVEX_URL=https://<deployment>.convex.cloud
# VITE_CONVEX_SITE_URL=https://<deployment>.convex.site
# Optional for local development and preview; production deployment requires it.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_DISABLED=
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_REQUIRED=false
# Explicit visual/demo fallback. Keep false for durable workspaces.
VITE_DEMO_MODE=false
VITE_RUNTIME_URL=http://127.0.0.1:4242
# Development only. Production Electron receives the runtime token over IPC.
VITE_RUNTIME_TOKEN=
