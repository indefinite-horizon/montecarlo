# Local companion settings. Copy to .env.runtime.local; never upload this file to Convex.
MONTE_CARLO_RUNTIME_HOST=127.0.0.1
MONTE_CARLO_RUNTIME_PORT=4242
MONTE_CARLO_RUNTIME_DEV=1
MONTE_CARLO_RUNTIME_TOKEN=
MONTE_CARLO_RUNTIME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://monte-carlo
# Optional comma-separated storage scope for a locked-down companion instance.
MONTE_CARLO_RUNTIME_WORKSPACE_IDS=

# Optional user-managed provider credentials. The Electron credential flow is preferred.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
# Optional path to the user's official Codex CLI when it is not on PATH.
CODEX_PATH=

# Optional administrator-provisioned key for this trusted local companion.
MONTE_CARLO_MANAGED_OPENROUTER_API_KEY=

# Local endpoints and storage.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Filesystem is always available. Selecting r2 (or filling R2 settings) enables
# R2 alongside it so local and cloud workspaces can coexist in one companion.
MONTE_CARLO_OBJECT_STORE=filesystem
# Optional. Defaults to the OS application-data directory.
MONTE_CARLO_WORKSPACES_DIR=

# R2-compatible object storage. Use only in a trusted runtime until the
# Better Auth-bound cloud gateway described in docs/NEW_PROD_DEPLOY.md exists.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=
